# --- Database -----------------------------------------------------------
# Writable connection. Used ONLY by src/lib/audit.ts, migrations, and seed.
DATABASE_URL=postgres://app:app@localhost:5432/internal_tools
# Read-only connection (SELECT-only Postgres role). Used by everything else.
DATABASE_URL_READONLY=postgres://app_readonly:readonly@localhost:5432/internal_tools

# --- Auth ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-only-secret-change-me
AUTH_URL=http://localhost:3000

# Dev-only "sign in as" provider (no external identity provider needed).
# Never set this in production.
AUTH_DEV_LOGIN=true

# --- Production OIDC (Okta / Entra ID) -----------------------------------
# Leave unset locally. Setting these three enables the OIDC provider with no
# code change. Roles are read from the `roles` (or `groups`) claim.
# OIDC_ISSUER=https://your-org.okta.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
